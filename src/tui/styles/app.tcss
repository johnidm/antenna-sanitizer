/* ---- Global ------------------------------------------------------------ */

Screen {
    background: $background;
}

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

Footer {
    background: $surface;
}

/* Rounded panel with a bold amber title; shared by every screen. */
.card {
    border: round $primary 60%;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $panel;
    padding: 1 2;

    &:focus, &:focus-within {
        border: round $primary;
    }
}

#body {
    padding: 1 2;
}

/* ---- Menu -------------------------------------------------------------- */

#menu-body {
    align: center middle;
    padding: 1 2;
}

#menu {
    width: 60;
    height: auto;
    padding: 0 1;

    & > .option-list--option-highlighted {
        background: $primary 20%;
        color: $foreground;
    }
}

#menu:focus > .option-list--option-highlighted {
    background: $primary 35%;
}


/* ---- Random stations --------------------------------------------------- */

#sample-heading {
    margin-bottom: 1;
    padding: 0 1;
}

#stations {
    grid-size: 3;
    grid-gutter: 1 2;
    grid-rows: auto;
    height: auto;

    &.-narrow {
        grid-size: 1;
    }
}

/* ---- Sanitize ---------------------------------------------------------- */

#development-placeholder {
    width: auto;
    max-width: 50;
    text-align: center;
    padding: 2 4;
}

/* ---- Stats ------------------------------------------------------------- */

#stats-heading {
    margin-bottom: 1;
    padding: 0 1;
}

#stats-grid {
    grid-size: 4;
    grid-gutter: 1 2;
    grid-rows: auto;
    height: auto;
    margin-bottom: 1;

    &.-narrow {
        grid-size: 2;
    }

    &.-very-narrow {
        grid-size: 1;
    }
}

#stats-breakdown {
    height: auto;
    margin-top: 1;
    padding: 1 2;
}

/* ---- Export SQL -------------------------------------------------------- */

#export-body {
    align: center middle;
    padding: 1 2;
}

#export-card {
    width: 68;
    height: auto;
    padding: 1 3;
}

#export-header-title {
    text-align: center;
    margin-bottom: 1;
}

#export-summary {
    margin-bottom: 1;
}

#export-guardrail {
    margin-bottom: 1;
    text-align: center;
}

#export-progress {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

#export-actions {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#export-actions Button {
    margin: 0 1;
}

/* ---- Add Station ------------------------------------------------------- */

#add-station-body {
    align: center middle;
    padding: 1 2;
    overflow-y: auto;
}

#add-station-card {
    width: 82;
    height: auto;
    padding: 1 3;
}

#add-station-header-title {
    text-align: center;
    margin-bottom: 0;
}

#add-station-subtitle {
    text-align: center;
    margin-bottom: 1;
}

#add-station-grid {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: auto;
    height: auto;
}

.field-group {
    height: auto;
}

.field-label {
    color: $text;
    text-style: bold;
    margin-bottom: 0;
}

.field-group Input {
    width: 100%;
}

#add-station-error {
    text-align: center;
    height: auto;
    min-height: 1;
    margin-top: 1;
}

#add-station-actions {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 1;
}

#add-station-actions Button {
    margin: 0 1;
}



