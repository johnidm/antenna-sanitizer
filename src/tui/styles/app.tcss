/* ---- Global ------------------------------------------------------------ */

Screen {
    background: $background;
}

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

Footer {
    background: $surface;
}

/* Rounded panel with a bold amber title; shared by every screen. */
.card {
    border: round $primary 60%;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $panel;
    padding: 1 2;

    &:focus, &:focus-within {
        border: round $primary;
    }
}

#body {
    padding: 1 2;
}

/* ---- Menu -------------------------------------------------------------- */

#menu-body {
    align: center middle;
    padding: 1 2;
}

#menu {
    width: 60;
    height: auto;
    padding: 0 1;

    & > .option-list--option-highlighted {
        background: $primary 20%;
        color: $foreground;
    }
}

#menu:focus > .option-list--option-highlighted {
    background: $primary 35%;
}

#stats {
    width: 60;
    margin-top: 1;
    text-align: center;
    color: $text-muted;
}

/* ---- Random stations --------------------------------------------------- */

#sample-heading {
    margin-bottom: 1;
    padding: 0 1;
}

#stations {
    grid-size: 3;
    grid-gutter: 1 2;
    grid-rows: auto;
    height: auto;

    &.-narrow {
        grid-size: 1;
    }
}

/* ---- Sanitize ---------------------------------------------------------- */

#development-placeholder {
    width: auto;
    max-width: 50;
    text-align: center;
    padding: 2 4;
}
